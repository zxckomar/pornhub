# --- НАДЕЖНЫЙ БЛОК НАПОМИНАНИЙ С ОПТИМИЗАЦИЕЙ СНА ---
MONTHS_DICT = {
    "января": 1, "февраля": 2, "марта": 3, "апреля": 4, "мая": 5, "июня": 6,
    "июля": 7, "августа": 8, "сентября": 9, "октября": 10, "ноября": 11, "декабря": 12
}

def reminder_scheduler():
    """Фоновый поток: каждую минуту (раз в 60 сек) проверяет базу данных на наличие напоминаний"""
    while True:
        try:
            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
            # Ищем неотправленные напоминания, время которых пришло или уже прошло
            cursor.execute("SELECT id, chat_id, reminder_text FROM reminders WHERE is_sent = 0 AND target_datetime <= ?", (now_str,))
            due_reminders = cursor.fetchall()
            
            for r_id, chat_id, text in due_reminders:
                bot.send_message(chat_id, f"⏰ *НАПОМИНАНИЕ:* \n\n👉 {text}", parse_mode="Markdown")
                
                # Помечаем в базе как отправленное
                cursor.execute("UPDATE reminders SET is_sent = 1 WHERE id = ?", (r_id,))
                conn.commit()
                
            conn.close()
        except Exception as e:
            print(f"Ошибка в планировщике напоминаний: {e}")
            
        time.sleep(60)  # Спим 1 минуту для полной разгрузки процессора


@bot.message_handler(commands=['remind'])
def start_remind(message):
    msg = bot.send_message(
        message.chat.id,
