#include <iostream>
#include <clocale>
#include <cmath>
#include <vector>
using namespace std;

void splice_array(const int* arr1, const int* arr2, int x1, int* arr3)
{
	for (int i = 0; i < x1;i += 1)
	{
		*(arr3 + (2 * i)) = *(arr1 + i);
		*(arr3 + (2 * i + 1)) = *(arr2 + i);
	}
}

int main()
{
	setlocale(LC_ALL, "RUS");
	int x1, x2;
	cout << "Введите размеры первого и второго массива(они должны быть одинаковы):\n";
	cin >> x1 >> x2;
	if (x1 != x2)
	{
		return 0;
	}

	vector<int>arr1;
	cout << "Введите " << x1 << " элементов первого массива:\n";
	for (int i = 0;i < x1;i += 1)
	{
		int x;
		cin >> x;
		arr1.push_back(x);
	}

	vector<int>arr2;
	cout << "Введите " << x2 << " элементов второго массива:\n";
	for (int i = 0;i < x2;i += 1)
	{
		int x;
		cin >> x;
		arr2.push_back(x);
	}
	vector<int>arr3(x1 * 2);
	
	splice_array(arr1.data(), arr2.data(), x1, arr3.data());

	cout << "Результат чередования:\n";
	const int* res = arr3.data();
	for (int i = 0; i < arr3.size(); i += 1)
	{
		cout << *(res + i) << " ";
	}
	cout << "\n";

	return 0;
}

