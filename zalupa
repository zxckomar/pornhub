def init_db():
    """Создает таблицы для задач и напоминаний, если они еще не существуют"""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # Таблица для ежедневника
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            date TEXT,
            task_text TEXT,
            is_done INTEGER DEFAULT 0
        )
    ''')
    
    # Таблица для надежных напоминаний
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS reminders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            chat_id INTEGER,
            reminder_text TEXT,
            target_datetime TEXT,
            is_sent INTEGER DEFAULT 0
        )
    ''')
    
    conn.commit()
    conn.close()

