@bot.callback_query_handler(func=lambda call: call.data == "add_task_input")
def request_task_text(call):
    bot.answer_callback_query(call.id)
    msg = bot.send_message(call.message.chat.id, "✍️ Напишите текст задачи (можно отправить сразу несколько задач, каждую с новой строки):")
    bot.register_next_step_handler(msg, save_new_task)


def save_new_task(message):
    if message.text and message.text.startswith('/'):
        bot.process_new_messages([message])
        return

    if message.text is None:
        bot.send_message(message.chat.id, "❌ Текст задачи не может быть пустым.")
        return

    user_id = message.from_user.id
    today_str = datetime.now().strftime("%d.%m.%Y")
    
    lines = message.text.split('\n')
    new_tasks = [line.strip() for line in lines if line.strip()]

    if not new_tasks:
        bot.send_message(message.chat.id, "❌ Вы прислали пустые строки. Задачи не добавлены.")
        return

    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    for task_text in new_tasks:
        cursor.execute("INSERT INTO tasks (user_id, date, task_text) VALUES (?, ?, ?)", (user_id, today_str, task_text))
        
    conn.commit()
    conn.close()

    added_tasks_str = "\n".join([f"• *{t}*" for t in new_tasks])
    bot.send_message(
        message.chat.id, 
        f"✅ Успешно добавлено задач: *{len(new_tasks)}* шт.\n\n{added_tasks_str}\n\nНаберите /tracker, чтобы обновить ежедневник.", 
        parse_mode="Markdown"
    )


