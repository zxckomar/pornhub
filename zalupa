        "Напишите ваше напоминание:",
        parse_mode="Markdown"
    )
    bot.register_next_step_handler(msg, parse_reminder)


def parse_reminder(message):
    if message.text and message.text.startswith('/'):
        bot.process_new_messages([message])
        return

    text = message.text
    if text is None:
        bot.send_message(message.chat.id, "Введите напоминание текстом!")
        return

    text_lower = text.lower().strip()
    now = datetime.now()
    target_datetime = None
    clean_text = ""

    months_pattern = "|".join(MONTHS_DICT.keys())
    pattern = r'(\d+)\s+(' + months_pattern + r')(?:\s+в)?(?:\s+(\d{1,2}):(\d{2}))?'
    date_match = re.search(pattern, text_lower)

    if date_match:
        day = int(date_match.group(1))
        month_name = date_match.group(2)
        month = MONTHS_DICT[month_name]

        has_time = date_match.group(3) is not None and date_match.group(4) is not None
        hour = int(date_match.group(3)) if has_time else 9
        minute = int(date_match.group(4)) if has_time else 0

        try:
            target_datetime = datetime(year=now.year, month=month, day=day, hour=hour, minute=minute)
            current_now = now.replace(second=0, microsecond=0)

            if target_datetime < current_now:
                if not (target_datetime.day == now.day and target_datetime.month == now.month):
                    target_datetime = target_datetime.replace(year=now.year + 1)
                else:
                    bot.send_message(message.chat.id, "❌ Это время на сегодня уже прошло!")
                    return

            clean_text = text[:date_match.start()].strip()
        except ValueError:
            bot.send_message(message.chat.id, "❌ Некорректный формат времени или даты.")
            return

    else:
        delta_match = re.search(r'через\s+(\d+)\s+(минут|мин|час)', text_lower)
        if delta_match:
            number = int(delta_match.group(1))
            time_type = delta_match.group(2)
            
            if "мин" in time_type:
                target_datetime = now + timedelta(minutes=number)
            else:
                target_datetime = now + timedelta(hours=number)
                
            clean_text = text[:delta_match.start()].strip()

    if target_datetime:
        if not clean_text:
            clean_text = "Действие без названия"

        db_time_str = target_datetime.strftime("%Y-%m-%d %H:%M:%S")
        
        # Запись напоминания в SQLite
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        cursor.execute("INSERT INTO reminders (chat_id, reminder_text, target_datetime) VALUES (?, ?, ?)",
                       (message.chat.id, clean_text, db_time_str))
        conn.commit()
        conn.close()

        date_user_str = target_datetime.strftime('%d.%m.%Y в %H:%M')
        bot.send_message(message.chat.id, f"✅ Железобетонно принято! Напомню про *\"{clean_text}\"* точно {date_user_str}.\nДанные записаны на диск 💾",
                         parse_mode="Markdown")
        return

    bot.send_message(
        message.chat.id,
        "❌ Не удалось распознать время. Используйте форматы:\n"
        "• *... через 15 минут*\n"
        "• *... 22 июня в 20:45*",
        parse_mode="Markdown"
    )


