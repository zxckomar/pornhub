def build_tracker_keyboard(user_id, today_str):
    markup = types.InlineKeyboardMarkup(row_width=1)
    
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT id, task_text, is_done FROM tasks WHERE user_id = ? AND date = ?", (user_id, today_str))
    tasks = cursor.fetchall()
    conn.close()

    for task_id, text, is_done in tasks:
        icon = "✅" if is_done == 1 else "❌"
        button_text = f"{icon} {text}"
        markup.add(types.InlineKeyboardButton(button_text, callback_data=f"toggle_{task_id}"))
    
    markup.add(types.InlineKeyboardButton("➕ Добавить задачу", callback_data="add_task_input"))
    
    if tasks:
        markup.add(types.InlineKeyboardButton("🗑️ Очистить все задачи", callback_data="clear_today_tasks"))
        
    return markup


